<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

	<variable name="logDirectory" value="C:\TEMP\ImageOrganizer"/>

	<targets>
		<target xsi:type="File" name="all"
				fileName="${logDirectory}/${shortdate}.log"
				layout="${longdate} ${uppercase:${level}} ${message}" />

		<target xsi:type="Console" name="aspnet"
				layout="${logger} ${uppercase:${level}} ${message}" />

		<target xsi:type="File" name="debug"
				fileName="${logDirectory}/${shortdate}.debug.log"
				layout="${longdate} ${uppercase:${level}} ${callsite} ${message}" />

		<target xsi:type="File" name="info"
				fileName="${logDirectory}/${shortdate}.info.log"
				layout="${longdate} ${message}" />

		<target xsi:type="File" name="exception"
			  fileName="${logDirectory}/${shortdate}.exception.log"
			  layout="${longdate} ${message}${newline}${exception:format=ToString} ${callsite} ${onexception:EXCEPTION OCCURRED\:${exception:format=tostring}} ${newline}${exception:format=ToString,StackTrace}"/>

		<target xsi:type="EventLog" name="EventLogger"
				layout="${longdate} ${message}${newline}${exception:format=ToString} ${callsite} ${onexception:EXCEPTION OCCURRED\:${exception:format=tostring}} ${newline}${exception:format=ToString,StackTrace}"
				source="FiresponseExternalIntegrationService" log="Application" />
	</targets>

	<rules>
		<logger name="*" minlevel="Warn" writeTo="EventLogger" />
		<logger name="*" minlevel="Warn" writeTo="exception" />
		<logger name="*" minlevel="Info" writeTo="info" />
		<logger name="*" minlevel="Debug" writeTo="debug"/>
		<logger name="*" minlevel="Trace" writeTo="aspnet" />
	</rules>
</nlog>
